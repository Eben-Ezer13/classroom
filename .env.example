# Required in every environment. Use a pooled URL at runtime and a direct URL
# for Prisma migrations.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_APP_URL=

# Reference time zone (IANA name): every date and time is entered and shown
# in this zone, on the server and in the browser. Change it if the class is
# not in Morocco (e.g. Europe/Paris, Africa/Abidjan, Africa/Douala).
NEXT_PUBLIC_APP_TIMEZONE=Africa/Casablanca

# Required in production for persistent uploads. Files are sent straight from
# the browser to Vercel Blob (Vercel functions reject requests over 4.5 MB).
STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=
# Must match the access mode chosen when the Blob store was created:
# "private" (recommended) or "public".
BLOB_ACCESS=private

# Required in production for password reset emails.
MAIL_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM=

# Required by the scheduled reminders endpoint in production.
CRON_SECRET=
